NODE_ENV=development
PORT=3000

# Core
MONGODB_URI=mongodb://localhost:27017/mabrigkorie
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Site URLs
SITE_URL=https://mabrigkorie.org
CLIENT_ORIGIN=https://mabrigkorie.org

# Google OAuth (admin/user login) - console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (image uploads for work covers / SEO previews) - cloudinary.com console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (transactional/contact-form email) - resend.com
RESEND_API_KEY=
CONTACT_EMAIL=

# Paystack (payments, if/when monetized features ship) - dashboard.paystack.com
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Optional AI providers (content generation / chat assist features)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
REPLICATE_API_TOKEN=
TAVILY_API_KEY=

# Scheduled job auth (e.g. Vercel Cron / external cron pinging an endpoint)
CRON_SECRET=
