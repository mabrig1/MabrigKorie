<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { meta }) %>
</head>
<body>

<%- include('partials/nav') %>

<section class="hero" style="padding:60px 0;">
  <div class="container">
    <div class="eyebrow"><%= work.category.toUpperCase() %><% if (work.platform) { %> · <%= work.platform %><% } %></div>
    <h1 style="font-size:2.2rem;"><%= work.title %></h1>
    <p class="tagline"><%= work.description %></p>
    <% if (work.tags && work.tags.length) { %>
      <div class="hero-roles">
        <% work.tags.forEach(function(t) { %><span class="role-pill"><%= t %></span><% }); %>
      </div>
    <% } %>
    <div class="btn-row">
      <% if (work.url) { %><a class="btn btn-primary" href="<%= work.url %>" target="_blank" rel="noopener">Visit Project →</a><% } %>
    </div>
    <%- include('partials/share', { work, siteUrl }) %>
  </div>
</section>

<% if (work.videoUrl) {
  const ytMatch = work.videoUrl.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([\w-]{11})/);
  const embedSrc = ytMatch ? `https://www.youtube.com/embed/${ytMatch[1]}` : null;
%>
  <% if (embedSrc) { %>
  <section class="container" style="padding:0 0 40px;">
    <div style="position:relative;padding-top:56.25%;max-width:860px;margin:0 auto;">
      <iframe src="<%= embedSrc %>" title="<%= work.title %>" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="position:absolute;top:0;left:0;width:100%;height:100%;border-radius:8px;"></iframe>
    </div>
  </section>
  <% } %>
<% } %>

<% if (work.content) { %>
<section class="container" style="padding:0 0 60px;">
  <div class="work-raw-content"><%- work.content %></div>
</section>
<% } %>

<%- include('partials/footer') %>

</body>
</html>
