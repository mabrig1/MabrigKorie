<%- include('partials/nav') %>
<main class="ds">
  <section class="ds-hero">
    <div class="container">
      <div class="ds-kicker">MABRIG TECHNOLOGIES / DEVSECOPS</div>
      <div class="ds-status"><span aria-hidden="true"></span> Open-source scanner available · Commercial API in early access</div>
      <h1>Secure your code.<br><em>Defend your applications.</em></h1>
      <p>DevShield AI helps developers identify changes that introduce risk, protect APIs with programmable edge security, and turn findings into meaningful next steps.</p>
      <div class="ds-actions">
        <a href="https://github.com/mabrig1/mabrig-devshield-ai" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Start with the Free Scanner ↗</a>
        <a href="mailto:mabrig@mabrigkorie.org?subject=DevShield%20Commercial%20API%20Early%20Access" class="btn btn-ghost">Request Commercial API Access</a>
