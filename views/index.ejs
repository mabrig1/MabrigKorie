<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { meta }) %>
</head>
<body>

<%- include('partials/nav') %>

<section class="hero hero-upgraded">
  <div class="container">
    <div class="eyebrow">Full-Stack Developer · Agentic AI Builder · Product Architect</div>
    <h1>I build AI-powered products that move from idea to production.</h1>
    <p class="tagline">
      I'm Mabrig Korie — a Nigerian full-stack developer building practical systems across AI automation,
      research, grants, education, developer security, agriculture and digital infrastructure.
    </p>

    <div class="hero-roles" aria-label="Core capabilities">
      <span class="role-pill">Agentic AI Systems</span>
      <span class="role-pill">Next.js / Node.js</span>
      <span class="role-pill">MongoDB / Supabase</span>
      <span class="role-pill">GitHub & DevSecOps</span>
      <span class="role-pill">Cloud Deployment</span>
      <span class="role-pill">AI Evaluation & Verification</span>
    </div>

    <div class="btn-row">
      <a class="btn btn-primary" href="#flagship">Explore Flagship Builds</a>
      <a class="btn btn-ghost" href="https://github.com/mabrig1" target="_blank" rel="noopener">GitHub Portfolio ↗</a>
      <a class="btn btn-ghost" href="mailto:mabrig@mabrigkorie.org">Work With Me</a>
    </div>

    <div class="proof-grid">
      <div class="proof-item">
        <strong>40+</strong>
        <span>repositories & product codebases</span>
      </div>
      <div class="proof-item">
        <strong>9</strong>
        <span>flagship engineering projects highlighted below</span>
      </div>
      <div class="proof-item">
        <strong>End-to-end</strong>
        <span>product, backend, AI, deployment & operations</span>
      </div>
      <div class="proof-item">
        <strong>Nigeria → Global</strong>
        <span>solutions designed for real-world constraints</span>
      </div>
    </div>
  </div>
</section>

<section id="flagship" class="alt-bg">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">Flagship Engineering Portfolio</div>
      <h2>Products that show how I build</h2>
      <p>
        Selected projects that best demonstrate full-stack engineering, agentic AI orchestration,
        AI assurance, workflow automation and production-minded product design.
      </p>
    </div>

    <div class="grid grid-3">
      <% featuredProjects.forEach(function(project) { %>
        <article class="card project-card">
          <div class="project-top">
            <span class="project-badge"><%= project.category %></span>
          </div>
          <h3><%= project.title %></h3>
          <p><%= project.description %></p>
          <p class="project-outcome"><strong>What it proves:</strong> <%= project.outcome %></p>
          <div class="project-stack">
            <% project.stack.forEach(function(tech) { %>
              <span class="chip"><%= tech %></span>
            <% }); %>
          </div>
          <div class="project-actions">
            <% if (project.live) { %>
              <a class="link" href="<%= project.live %>" target="_blank" rel="noopener">Live Product ↗</a>
            <% } %>
            <a class="link" href="<%= project.repo %>" target="_blank" rel="noopener">GitHub ↗</a>
          </div>
        </article>
      <% }); %>
    </div>

    <div class="btn-row section-cta">
      <a class="btn btn-ghost" href="/projects">Browse More Projects</a>
      <a class="btn btn-ghost" href="https://github.com/mabrig1" target="_blank" rel="noopener">View All Repositories</a>
    </div>
  </div>
</section>

<section id="skills">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">Technical Strengths</div>
      <h2>From product strategy to verified deployment</h2>
      <p>
        My strongest work sits at the intersection of software engineering, agentic AI,
        automation and high-trust information workflows.
      </p>
    </div>

    <div class="skill-grid">
      <div class="card skill-card">
        <span class="skill-number">01</span>
        <h3>Agentic AI & Automation</h3>
        <ul class="skill-list">
          <li>Multi-stage agent orchestration</li>
          <li>OpenRouter / Claude integrations</li>
          <li>Tool-using assistants and workflow agents</li>
          <li>Evidence-aware drafting and verification flows</li>
        </ul>
      </div>

      <div class="card skill-card">
        <span class="skill-number">02</span>
        <h3>Full-Stack Product Engineering</h3>
        <ul class="skill-list">
          <li>Next.js, React, Node.js and Express</li>
          <li>REST APIs, auth and admin dashboards</li>
          <li>MongoDB, PostgreSQL and Supabase</li>
          <li>Responsive product UX and workflow design</li>
        </ul>
      </div>

      <div class="card skill-card">
        <span class="skill-number">03</span>
        <h3>Cloud, CI/CD & DevSecOps</h3>
        <ul class="skill-list">
          <li>Vercel and GitHub deployment flows</li>
          <li>Cloudflare R2 and edge infrastructure</li>
          <li>GitHub Actions, SARIF and merge gates</li>
          <li>Dependency, secret and policy checks</li>
        </ul>
      </div>

      <div class="card skill-card">
        <span class="skill-number">04</span>
        <h3>Research & Document Intelligence</h3>
        <ul class="skill-list">
          <li>Grant intelligence and eligibility workflows</li>
          <li>Academic formatting and citation systems</li>
          <li>Document generation and export pipelines</li>
          <li>AI-assisted research operations</li>
        </ul>
      </div>

      <div class="card skill-card">
        <span class="skill-number">05</span>
        <h3>Product Monetization</h3>
        <ul class="skill-list">
          <li>Paystack and Flutterwave integrations</li>
          <li>Subscriptions, project billing and invoices</li>
          <li>Learning products and digital services</li>
          <li>Portfolio-to-opportunity product strategy</li>
        </ul>
      </div>

      <div class="card skill-card">
        <span class="skill-number">06</span>
        <h3>AI Assurance Mindset</h3>
        <ul class="skill-list">
          <li>Source grounding and claim verification</li>
          <li>Human review boundaries</li>
          <li>Prompt-injection-resistant workflows</li>
          <li>Build → test → audit → document honestly</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section id="about" class="alt-bg">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">Builder Profile</div>
      <h2>I ship across domains, but the engineering pattern stays consistent.</h2>
      <p>
        I identify a real workflow, model the problem, build the product, connect the infrastructure,
        deploy it, then improve it from evidence. My portfolio spans research, education, grants,
        agriculture, publishing, fintech, ministry technology and developer tooling.
      </p>
    </div>

    <div class="grid grid-2 builder-grid">
      <div class="card build-card">
        <span class="skill-number">A</span>
        <h3>Discover</h3>
        <p>Translate a real operational problem into a product scope, user journey and measurable outcome.</p>
      </div>
      <div class="card build-card">
        <span class="skill-number">B</span>
        <h3>Architect</h3>
        <p>Choose the right data, auth, AI, storage, payment and deployment components without unnecessary complexity.</p>
      </div>
      <div class="card build-card">
        <span class="skill-number">C</span>
        <h3>Ship</h3>
        <p>Build the working frontend and backend, integrate services, deploy, document and make the system usable.</p>
      </div>
      <div class="card build-card">
        <span class="skill-number">D</span>
        <h3>Verify</h3>
        <p>Audit claims against implementation, test failure modes, add safeguards and keep roadmap items clearly separated from shipped features.</p>
      </div>
    </div>

    <div class="bio-points">
      <% bioPoints.forEach(function(point) { %>
        <span class="bio-pill">✦ <%= point %></span>
      <% }); %>
    </div>

    <div class="stat-row portfolio-stats">
      <div class="stat-card"><div class="num counter" data-target="<%= stats.apps %>">0</div><div class="lbl">Catalogued Apps & Platforms</div></div>
      <div class="stat-card"><div class="num counter" data-target="<%= stats.books %>">0</div><div class="lbl">Books in Portfolio Database</div></div>
      <div class="stat-card"><div class="num counter" data-target="<%= stats.research %>">0</div><div class="lbl">Research Works</div></div>
      <div class="stat-card"><div class="num counter" data-target="<%= stats.music %>">0</div><div class="lbl">Music Releases</div></div>
    </div>
  </div>
</section>

<% function renderSection(id, eyebrow, title, intro, items, viewAllHref) { %>
  <section id="<%= id %>"<%= id === 'research' || id === 'music' ? ' class="alt-bg"' : '' %>>
    <div class="container">
      <div class="section-head">
        <div class="eyebrow"><%= eyebrow %></div>
        <h2><%= title %></h2>
        <p><%= intro %></p>
      </div>
      <% if (items.length === 0) { %>
        <p style="text-align:center;color:var(--muted);">More coming soon.</p>
      <% } else { %>
        <div class="grid grid-3">
          <% items.forEach(function(work) { %>
            <div class="card">
              <% if (work.platform) { %><span class="tag"><%= work.platform %></span><% } %>
              <h3><%= work.title %></h3>
              <p><%= work.description %></p>
              <% if (work.url) { %>
                <a class="link" href="<%= work.url %>" target="_blank" rel="noopener">Visit →</a>
              <% } %>
              <%- include('partials/share', { work, siteUrl }) %>
            </div>
          <% }); %>
        </div>
      <% } %>
      <div class="btn-row section-cta">
        <a class="btn btn-ghost" href="<%= viewAllHref %>">View All →</a>
      </div>
    </div>
  </section>
<% } %>

<% renderSection('projects', 'Extended Product Portfolio', 'More Web Applications & Platforms', 'Additional deployed and experimental products across the MABRIG technology portfolio.', byCategory.app, '/projects') %>
<% renderSection('research', 'Research & Writing', 'Research Portfolio', 'Selected research and interdisciplinary writing alongside applied research technology.', byCategory.research, '/research') %>
<% renderSection('books', 'Authorship', 'Books & Publications', 'A parallel publishing practice across faith, prayer, identity and personal development.', byCategory.book, '/books') %>
<% renderSection('music', 'Music & Ministry', 'Gospel Discography', 'Faith-centered music, worship and revival releases.', byCategory.music, '/music') %>
<% renderSection('services', 'Collaborate', 'Engineering & AI Services', 'Product development, AI workflows, research technology, document automation and digital strategy.', byCategory.service, '/services') %>

<section id="contact" class="contact-panel">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">Build With Me</div>
      <h2>Need a product builder who can connect AI, software and real operations?</h2>
      <p>
        Available for selected product builds, AI systems, research technology collaborations,
        technical fellowships and high-impact digital projects.
      </p>
    </div>
    <div class="btn-row">
      <a class="btn btn-primary" href="mailto:mabrig@mabrigkorie.org">mabrig@mabrigkorie.org</a>
      <a class="btn btn-ghost" href="https://github.com/mabrig1" target="_blank" rel="noopener">github.com/mabrig1</a>
    </div>
    <%- include('partials/social-links', { socialLinks }) %>
  </div>
</section>

<%- include('partials/footer') %>

<script src="/public/js/site.js"></script>
</body>
</html>
