<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { meta }) %>
</head>
<body>

<%- include('partials/nav') %>

<section class="hero">
  <div class="container">
    <div class="eyebrow">Author · Researcher · Gospel Musician · Full-Stack Developer · Digital Entrepreneur</div>
    <h1>Mabrig Korie</h1>
    <p class="tagline">
      Building platforms, publishing ideas, creating music, and transforming lives through faith, technology, and knowledge.
    </p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/projects">View Projects</a>
      <a class="btn btn-ghost" href="/books">Read Books</a>
      <a class="btn btn-ghost" href="/music">Listen to Music</a>
      <a class="btn btn-ghost" href="/contact">Contact Me</a>
    </div>
  </div>
</section>

<section id="about">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">About</div>
      <h2>Disciplined, end-to-end work</h2>
      <p>
        I designed and built <strong>Destiny Skills Bridge</strong>, a live MERN-stack e-learning platform that takes
        Nigerian learners from zero to income-earning freelance skills. I'm also a published author, founder of an
        academic research institute, and a gospel artist releasing prophetic worship music across major streaming
        platforms.
      </p>
    </div>
    <div class="grid grid-2" style="max-width:700px;margin:0 auto;">
      <ul style="list-style:none;display:flex;flex-direction:column;gap:12px;">
        <% bioPoints.forEach(function(point) { %>
          <li class="card" style="padding:16px 20px;display:flex;align-items:center;gap:10px;">
            <span style="color:var(--accent);">✦</span> <%= point %>
          </li>
        <% }); %>
      </ul>
    </div>

    <div class="stat-row" style="margin-top:50px;max-width:800px;margin-left:auto;margin-right:auto;">
      <div class="stat-card"><div class="num counter" data-target="<%= stats.apps %>">0</div><div class="lbl">Apps & Platforms</div></div>
      <div class="stat-card"><div class="num counter" data-target="<%= stats.books %>">0</div><div class="lbl">Books Published</div></div>
      <div class="stat-card"><div class="num counter" data-target="<%= stats.research %>">0</div><div class="lbl">Research Papers</div></div>
      <div class="stat-card"><div class="num counter" data-target="<%= stats.music %>">0</div><div class="lbl">Music Releases</div></div>
    </div>
  </div>
</section>

<% function renderSection(id, eyebrow, title, intro, items, viewAllHref) { %>
  <section id="<%= id %>"<%= id === 'research' || id === 'music' ? ' class="alt-bg"' : '' %>>
    <div class="container">
      <div class="section-head">
        <div class="eyebrow"><%= eyebrow %></div>
        <h2><%= title %></h2>
        <p><%= intro %></p>
      </div>
      <% if (items.length === 0) { %>
        <p style="text-align:center;color:var(--muted);">More coming soon.</p>
      <% } else { %>
        <div class="grid grid-3">
          <% items.forEach(function(work) { %>
            <div class="card">
              <% if (work.platform) { %><span class="tag"><%= work.platform %></span><% } %>
              <h3><%= work.title %></h3>
              <p><%= work.description %></p>
              <% if (work.url) { %>
                <a class="link" href="<%= work.url %>" target="_blank" rel="noopener">Visit →</a>
              <% } %>
              <%- include('partials/share', { work, siteUrl }) %>
            </div>
          <% }); %>
        </div>
      <% } %>
      <div class="btn-row" style="margin-top:30px;">
        <a class="btn btn-ghost" href="<%= viewAllHref %>">View All →</a>
      </div>
    </div>
  </section>
<% } %>

<% renderSection('projects', 'Apps & Platforms Built', 'Web Applications & Research Platforms', 'Live, deployed products designed and built end-to-end — backend, frontend, and content.', byCategory.app, '/projects') %>
<% renderSection('research', 'Academic & Scientific Writing', 'Mabrig Journal of Interdisciplinary Research', 'Selected published work spanning AI Ethics, Security Studies, Political Economy, Theology, Public Health, and Pharmacology.', byCategory.research, '/research') %>
<% renderSection('books', 'Authorship', 'Books & Publications', '40+ published books on prayer, spiritual warfare, identity, and personal development.', byCategory.book, '/books') %>
<% renderSection('music', 'Music & Ministry', 'Gospel Discography', 'Prophetic worship and deliverance music as a Nigerian gospel artist and minister.', byCategory.music, '/music') %>
<% renderSection('services', 'Hire Me', 'Core Service Offerings', 'End-to-end capability across development, AI solutions, research, publishing, and content strategy.', byCategory.service, '/services') %>

<section id="contact">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">Get In Touch</div>
      <h2>Let's Build Something Impactful</h2>
      <p>Based in Port Harcourt, Rivers State, Nigeria. Open to development, writing, research, and production projects.</p>
    </div>
    <div class="btn-row">
      <a class="btn btn-primary" href="mailto:contact@mabrigkorie.org">contact@mabrigkorie.org</a>
    </div>
    <%- include('partials/social-links', { socialLinks }) %>
  </div>
</section>

<%- include('partials/footer') %>

<script src="/public/js/site.js"></script>
</body>
</html>
