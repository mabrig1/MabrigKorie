<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Recover Admin Access — Mabrig Korie</title>
<link rel="stylesheet" href="/public/css/style.css">
<meta name="referrer" content="no-referrer">
</head>
<body>
<div class="login-wrap">
  <div class="login-card">
    <h1>Recover Admin Access</h1>
    <p class="sub">Mabrig Korie Portfolio — Content Hub</p>
    <% if (submitted) { %>
      <p role="status">If this is the authorized admin recovery address, a password-reset email will be sent. Check your inbox and spam folder.</p>
      <p>Reset links expire after 15 minutes and can be used only once.</p>
    <% } else { %>
      <p>Enter the recovery email configured for the administrator.</p>
      <form method="POST" action="/admin/login/forgot-password">
        <div class="field">
          <label for="email">Admin recovery email</label>
          <input id="email" type="email" name="email" autocomplete="email" required autofocus>
        </div>
        <button class="btn btn-primary" type="submit" style="width:100%;">Send reset link</button>
      </form>
    <% } %>
    <p style="margin-top:18px;text-align:center"><a href="/admin/login">Back to admin login</a></p>
  </div>
</div>
</body>
</html>
