<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { meta }) %>
</head>
<body>

<%- include('partials/nav') %>

<section class="hero" style="padding:90px 0;">
  <div class="container">
    <div class="eyebrow">Book a Session</div>
    <h1 style="font-size:2.4rem;">Let's Get Your Project Moving</h1>
    <p class="tagline">Pick a service and a preferred date — I'll confirm your slot by email within 24 hours.</p>
  </div>
</section>

<section style="border-top:none;padding-top:0;">
  <div class="container">
    <div class="grid grid-2" style="max-width:640px;margin:0 auto;">
      <form id="bookingForm" class="card" style="grid-column:1/-1;">
        <div class="field">
          <label>Full Name</label>
          <input type="text" id="b_name" required>
        </div>
        <div class="field">
          <label>Email</label>
          <input type="email" id="b_email" required>
        </div>
        <div class="field">
          <label>Phone (optional)</label>
          <input type="tel" id="b_phone">
        </div>
        <div class="field">
          <label>Service</label>
          <select id="b_service" required>
            <option value="">Select a service…</option>
            <option value="Full-Stack Web App Development">Full-Stack Web App Development</option>
            <option value="Research Assistant">Research Assistant</option>
            <option value="Grant Writing">Grant Writing</option>
            <option value="Article Publishing">Article Publishing</option>
            <option value="Book Publishing">Book Publishing</option>
            <option value="Music Production">Music Production</option>
            <option value="Content Writing Assistance">Content Writing Assistance</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div class="field">
          <label>Preferred Date</label>
          <input type="date" id="b_date" required>
        </div>
        <div class="field">
          <label>Preferred Time</label>
          <input type="time" id="b_time">
        </div>
        <div class="field">
          <label>Tell me about your project</label>
          <textarea id="b_message" placeholder="A few sentences on what you need help with…"></textarea>
        </div>
        <div class="btn-row" style="justify-content:flex-start;">
          <button type="submit" class="btn btn-primary">Request Appointment →</button>
        </div>
        <p id="bookingStatus" style="margin-top:14px;font-size:0.88rem;"></p>
      </form>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

<script src="/public/js/booking.js"></script>
</body>
</html>
