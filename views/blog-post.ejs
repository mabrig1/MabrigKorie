<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { meta }) %>
</head>
<body>

<%- include('partials/nav') %>

<section class="hero" style="padding:60px 0;">
  <div class="container">
    <div class="eyebrow">
      <%= new Date(post.publishedAt || post.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
    </div>
    <h1 style="font-size:2.2rem;"><%= post.title %></h1>
    <% if (post.excerpt) { %><p class="tagline"><%= post.excerpt %></p><% } %>
    <% if (post.tags && post.tags.length) { %>
      <div class="hero-roles">
        <% post.tags.forEach(function(t) { %><span class="role-pill"><%= t %></span><% }); %>
      </div>
    <% } %>
  </div>
</section>

<section class="container" style="padding:0 0 60px;">
  <% if (post.coverImage) { %>
    <img src="<%= post.coverImage %>" alt="<%= post.title %>" style="width:100%;border-radius:12px;margin-bottom:30px;">
  <% } %>
  <div class="work-raw-content"><%- post.content %></div>
</section>

<%- include('partials/footer') %>

</body>
</html>
