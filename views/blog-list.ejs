<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { meta }) %>
</head>
<body>

<%- include('partials/nav') %>

<section class="hero" style="padding:60px 0;">
  <div class="container">
    <div class="eyebrow">Writing</div>
    <h1 style="font-size:2.2rem;">Blog</h1>
    <p class="tagline">Articles on faith, technology, research, and creative work.</p>
  </div>
</section>

<section style="border-top:none;padding-top:0;">
  <div class="container">
    <% if (posts.length === 0) { %>
      <p style="text-align:center;color:var(--muted);">No posts yet. Check back soon.</p>
    <% } else { %>
      <div class="grid grid-3">
        <% posts.forEach(function(post) { %>
          <div class="card">
            <% if (post.tags && post.tags.length) { %><span class="tag"><%= post.tags[0] %></span><% } %>
            <h3><%= post.title %></h3>
            <p><%= post.excerpt || '' %></p>
            <a class="link" href="/blog/<%= post.slug %>">Read →</a>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>

<script src="/public/js/site.js"></script>
</body>
</html>
